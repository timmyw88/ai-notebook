# Only needed if you want to build for GitHub Pages on your own computer.
# The GitHub Actions workflow sets both values automatically.

# Full public URL of the site, no trailing slash
SITE_URL=http://localhost:3000

# Sub-path when the site lives at https://<user>.github.io/<repo>/  (e.g. /ai-knowledge-blog)
# Leave empty for local use or a custom domain.
NEXT_PUBLIC_BASE_PATH=
